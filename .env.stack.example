# Copy to .env.stack in this directory (gitignored), then edit secrets.
#
#   cp .env.stack.example .env.stack
#   docker compose -f docker-compose.stack.yml --env-file .env.stack up -d --build
#
# Data: Postgres uses a Compose named volume (survives `docker compose down`; avoid `down -v` if you need data).
#
# Stack publishes:
#   - Postgres: host POSTGRES_HOST_PORT → container 5432 (DBeaver: localhost + this port + POSTGRES_* below)
#   - API:  host port API_PORT → container port 9091 (Spring always listens on 9091 inside the stack)
#   - Web:  host port WEB_PORT → nginx port 80 (Angular prod build; nginx proxies /api to the API)

# Host port for Postgres (default 5433 matches application.yml local JDBC; use 5434 if dev `docker compose` also uses 5433).
POSTGRES_HOST_PORT=5433

POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=tracker

TRACKER_AUTH_JWT_SECRET=change-me-min-32-chars-for-hs256-signing-secret-key
TRACKER_AUTH_PASSWORD_PEPPER=change-me-random-pepper
TRACKER_AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-bootstrap-password

# Host port mapped to API container port 9091.
API_PORT=9091

# Host port for the Angular static site (nginx). Avoid 8080 if another service uses it.
WEB_PORT=9080

# CORS origin pattern for browser clients (see Spring allowedOriginPatterns).
# Use * only on trusted networks; prefer https://your-domain.example when exposing to the internet.
CORS_PATTERN=*
