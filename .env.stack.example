# Copy to .env.stack in this directory (gitignored), then edit secrets.
#
#   cp .env.stack.example .env.stack
#   docker compose -f docker-compose.stack.yml --env-file .env.stack up -d --build
#
# Data: Postgres uses a Compose named volume (survives `docker compose down`; avoid `down -v` if you need data).
#
# Stack publishes:
#   - Postgres: 127.0.0.1:POSTGRES_HOST_PORT → container 5432 (not on the public NIC; DBeaver from your laptop: SSH tunnel, then localhost + this port)
#   - API:  host port API_PORT → container port 9091 (Spring always listens on 9091 inside the stack)
#   - Web:  WEB_PORT_BIND (host:container) → nginx port 80 (e.g. 9080:80 or 127.0.0.1:9080:80 behind Caddy)
# Lightsail / public HTTP: e.g. WEB_PORT_BIND=80:80 and open TCP 80. With Caddy HTTPS, use 127.0.0.1:9080:80 and open 80+443.

# Host port for Postgres (default 5433 matches application.yml local JDBC; use 5434 if dev `docker compose` also uses 5433).
POSTGRES_HOST_PORT=5433

POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=tracker

TRACKER_AUTH_JWT_SECRET=change-me-min-32-chars-for-hs256-signing-secret-key
TRACKER_AUTH_PASSWORD_PEPPER=change-me-random-pepper
TRACKER_AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-bootstrap-password

# Host port mapped to API container port 9091.
API_PORT=9091

# Optional: cap Maven JVM heap during `docker compose build api` (Dockerfile MAVEN_HEAP). Use 512m on 1GB
# Lightsail plans if the instance freezes during builds; add 1–2G swap on the VM as well.
# MAVEN_BUILD_HEAP=512m

# Host port mapping to nginx:80. Local dev: 9080:80. Lightsail direct HTTP: 80:80.
# With Caddy (HTTPS) on 80/443, bind nginx to localhost only: 127.0.0.1:9080:80
WEB_PORT_BIND=9080:80

# Optional — Caddy + Let's Encrypt (merge docker-compose.https-lightsail.yml; see README).
# When CADDY_DOMAIN is set below, scripts/lightsail-deploy.sh auto-merges that file so HTTPS survives each deploy.
# To keep a domain line but skip Caddy (e.g. another reverse proxy), set: TRACKER_CADDY_DISABLE=1
# CADDY_DOMAIN=tracker.example.com

# CORS origin pattern for browser clients (see Spring allowedOriginPatterns).
# Use * only on trusted networks; with HTTPS set to your site origin, e.g. https://tracker.example.com
CORS_PATTERN=*

# Journal file attachments: leave unset to use the local data directory (or tmp). If set, files go to S3; use
# the default AWS credential chain on the host (e.g. instance profile, environment keys).
#
# Lightsail object storage bucket `tracker-pg-journal`:
#   1. Lightsail → Storage → your bucket → Access keys — use those as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#      OR attach an IAM policy with s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket on the bucket ARN.
#   2. Set TRACKER_JOURNAL_S3_REGION to the bucket region shown in Lightsail (e.g. us-east-2).
#   3. If uploads still return AccessDenied, set TRACKER_JOURNAL_S3_PUT_ACL=bucket-owner-full-control
#      (required by some Lightsail buckets for S3 PutObject).
# Standard S3 buckets with "Bucket owner enforced" object ownership: leave PUT_ACL unset.
#
# TRACKER_JOURNAL_S3_BUCKET=tracker-pg-journal
# TRACKER_JOURNAL_S3_REGION=us-east-2
# TRACKER_JOURNAL_S3_PUT_ACL=bucket-owner-full-control
#
# Disk fallback (no S3): leave S3_BUCKET empty and set STORAGE_DIR; merge docker-compose.journal-local.yml.
# TRACKER_JOURNAL_STORAGE_DIR=/data/journal-attachments

# --- Auth MFA SMS (optional) ---
# Default: provider=log (OTP printed in API logs only). For real SMS use Amazon SNS:
#   TRACKER_AUTH_SMS_ENABLED=true
#   TRACKER_AUTH_SMS_PROVIDER=sns
#   TRACKER_AUTH_SMS_AWS_REGION=us-east-1
# User phone must be E.164; grant the API IAM permission sns:Publish. Same AWS credential chain as S3/SES.
# TRACKER_AUTH_SMS_SMS_TYPE=TRANSACTIONAL
# TRACKER_AUTH_SMS_SMS_SENDER_ID=

# --- Finance stock alerts (optional) ---
#
# Users create rules under Finance → Alerts. Recipients/channels are provisioned under Admin → Finance.
# Outbound email: Amazon SES (default) or SMTP (e.g. Gmail). SMS uses Amazon SNS when enabled.
TRACKER_FINANCE_ALERTS_EMAIL_ENABLED=false
# TRACKER_FINANCE_ALERTS_EMAIL_FROM=alerts@verified-domain.example.com
# TRACKER_FINANCE_ALERTS_EMAIL_TRANSPORT=ses
# --- SMTP (when EMAIL_TRANSPORT=smtp; omit AWS SES IAM for email only) ---
# TRACKER_FINANCE_ALERTS_EMAIL_TRANSPORT=smtp
# TRACKER_FINANCE_ALERTS_SMTP_HOST=smtp.gmail.com
# TRACKER_FINANCE_ALERTS_SMTP_PORT=587
# TRACKER_FINANCE_ALERTS_SMTP_USERNAME=
# TRACKER_FINANCE_ALERTS_SMTP_PASSWORD=
# Optional: Jakarta Mail wire trace (verbose). TRACKER_FINANCE_ALERTS_SMTP_DEBUG=true
TRACKER_FINANCE_ALERTS_SMS_ENABLED=false
# AWS region: required for SES email (email-transport=ses) and/or SNS SMS when SMS is enabled; not required for SMTP-only email.
# TRACKER_FINANCE_ALERTS_AWS_REGION=us-east-1
# Optional SNS direct SMS tuning:
# TRACKER_FINANCE_ALERTS_SMS_SMS_TYPE=TRANSACTIONAL
# TRACKER_FINANCE_ALERTS_SMS_SENDER_ID=
# If not using an instance role, set standard AWS env vars for the API container (never commit real keys):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Contact us (/contact) — who receives member feedback email.
# Recommended production: set ADMIN_EMAILS to real inboxes (ignores ADMIN profile placeholder emails).
# TRACKER_FEEDBACK_ADMIN_EMAILS=you@gmail.com,other-admin@example.com
# Optional blocklist when admin-emails is unset (still collects from ADMIN member profiles):
# TRACKER_FEEDBACK_EXCLUDED_ADMIN_EMAILS=notanemail@mail.com
# TRACKER_FEEDBACK_FALLBACK_ADMIN_EMAILS=

# Alpha Vantage stock quotes (Finance crawl / alerts). Disabled by default — set true to enable HTTP calls.
# TRACKER_FINANCE_ALPHA_VANTAGE_ENABLED=false
# TRACKER_FINANCE_ALPHA_VANTAGE_API_KEY=

# --- Admin → Repository (GitHub) insights (optional) ---
# Public repo: enable + owner + repo is enough (anonymous API rate limits apply). Private repo or traffic/views:
# set TRACKER_GITHUB_TOKEN to a classic PAT (repo scope) or fine-grained token with repository read + (for traffic) push.
# TRACKER_GITHUB_ENABLED=true
# TRACKER_GITHUB_OWNER=bittext
# TRACKER_GITHUB_REPO=tracker-pg
# TRACKER_GITHUB_TOKEN=

# --- Banking + Plaid (optional) ---
# Host path mounted into the API container so uploads + Plaid QFX land on disk (e.g. /home/ubuntu/imports/banking).
# Plaid writes under .../TRACKER_PLAID_OUTPUT_SUBDIRECTORY (default: plaid) → /home/ubuntu/imports/banking/plaid/...
# TRACKER_BANKING_IMPORT_DIRECTORY=/home/ubuntu/imports/banking
# TRACKER_PLAID_ENABLED=true
# TRACKER_PLAID_CLIENT_ID=
# TRACKER_PLAID_SECRET=
# TRACKER_PLAID_ENVIRONMENT=sandbox
# TRACKER_PLAID_OUTPUT_SUBDIRECTORY=plaid
# Recommended when Plaid is enabled: AES-256-GCM seals access_token in Postgres (long random passphrase, or Base64 32-byte key).
# TRACKER_PLAID_ACCESS_TOKEN_ENCRYPTION_KEY=

# --- Finance → Trading → Predicts (community sentiment + attention) ---
#
# Polls StockTwits for tracked tickers, batch-scores with FinBERT (ProsusAI/finbert) running in the
# `finbert` sidecar container, then rolls per-source mention counts into baselines for spike detection.
# Reddit + X ingestion are wired but disabled by default (no API credentials yet).
TRACKER_FINANCE_PREDICTS_ENABLED=true
TRACKER_FINANCE_PREDICTS_STOCKTWITS_ENABLED=true
TRACKER_FINANCE_PREDICTS_REDDIT_ENABLED=false
# When TRACKER_FINANCE_PREDICTS_REDDIT_ENABLED=true, you must provide OAuth credentials. Create a
# Reddit app (type "script") at https://www.reddit.com/prefs/apps/ and paste the client id + secret here.
# A descriptive User-Agent including a contact identifier is required by Reddit's API rules.
# TRACKER_FINANCE_PREDICTS_REDDIT_CLIENT_ID=
# TRACKER_FINANCE_PREDICTS_REDDIT_CLIENT_SECRET=
# TRACKER_FINANCE_PREDICTS_REDDIT_USER_AGENT=tracker-pg/10.0.0 (github.com/bittext/tracker-pg; finance-predicts)
# Comma-separated subreddits scanned each cycle (no leading r/). Default covers the four canonical retail subs.
# TRACKER_FINANCE_PREDICTS_REDDIT_SUBREDDITS=wallstreetbets,stocks,investing,options
# TRACKER_FINANCE_PREDICTS_REDDIT_POSTS_PER_SUBREDDIT=100
# TRACKER_FINANCE_PREDICTS_REDDIT_POLL_SECONDS=900
TRACKER_FINANCE_PREDICTS_X_ENABLED=false
# Set to false to skip the FinBERT container entirely; Java side uses a bullish/bearish heuristic fallback.
TRACKER_FINANCE_PREDICTS_FINBERT_ENABLED=true
# Stack-internal URL; expose externally only for debugging.
# TRACKER_FINANCE_PREDICTS_FINBERT_BASE_URL=http://finbert:8000
# Per-member quota of explicitly tracked tickers (Robinhood holdings auto-seed in addition to this).
# TRACKER_FINANCE_PREDICTS_TRACKED_TICKER_QUOTA_PER_USER=25
# Days of bucket history used to compute hour-of-week baselines (mean/stddev).
# TRACKER_FINANCE_PREDICTS_BASELINE_WINDOW_DAYS=30
# Raw mention retention; aggregated buckets are kept indefinitely.
# TRACKER_FINANCE_PREDICTS_RETENTION_MENTIONS_DAYS=60

# Optional FinBERT sidecar tuning (defaults are usually fine):
# FINBERT_MODEL=ProsusAI/finbert
# FINBERT_MAX_BATCH=64
# FINBERT_MAX_TOKENS=256
# FINBERT_DEVICE=cpu

# --- Management → Account at-rest encryption (recommended in production) ---
# AES-256-GCM seal of the per-entry password + authenticator key in the management_accounts table.
# Empty = plaintext at rest (dev only). Use a long random passphrase or a Base64-encoded 32-byte key.
# WARNING: changing this key invalidates existing sealed rows (decrypt will fail). Rotate carefully.
# TRACKER_MANAGEMENT_ACCOUNTS_ENCRYPTION_KEY=

# --- Robinhood CSV directory import (optional) ---
#
# Your Mac paths like /Users/pulickal/OneDrive/... are only valid when the Spring API runs on your Mac
# (e.g. SPRING_PROFILES_ACTIVE=local and application-local.yml). They are not visible inside a Lightsail
# Docker container; there you map Ubuntu directories into the container (docker-compose.robinhood.yml).
#
# Without docker-compose.robinhood.yml, set container-visible paths if you mount volumes yourself:
# TRACKER_FINANCE_ROBINHOOD_CSV_IMPORT_DIRECTORY=/robinhood/import
# TRACKER_FINANCE_ROBINHOOD_CSV_UPLOADED_DIRECTORY=/robinhood/uploaded
#
# With: docker compose -f docker-compose.stack.yml -f docker-compose.robinhood.yml --env-file .env.stack up -d
# the merge file sets those two to /robinhood/import and /robinhood/uploaded. On the VM, create host dirs and
# copy CSVs in (scp/rsync), or override host paths:
# ROBINHOOD_CSV_IMPORT_HOST_DIR=/home/ubuntu/robinhood/reports/import
# ROBINHOOD_CSV_UPLOADED_HOST_DIR=/home/ubuntu/robinhood/reports/uploaded

# --- Robinhood Jupyter / notebook sidecar (optional) ---
#
# docker compose -f docker-compose.stack.yml -f docker-compose.robinhood-jupyter.yml --env-file .env.stack up -d
#
# TRACKER_FINANCE_ROBINHOOD_JUPYTER_LAB_URL=http://127.0.0.1:8888/lab
# TRACKER_FINANCE_ROBINHOOD_NOTEBOOK_SERVICE_ENABLED=true
# When true, scripts/lightsail-deploy.sh also builds/starts robinhood-notebook (or touch .use-lightsail-robinhood-notebook).
# TRACKER_FINANCE_ROBINHOOD_NOTEBOOK_SERVICE_BASE_URL=http://robinhood-notebook:8010
# TRACKER_FINANCE_ROBINHOOD_NOTEBOOK_SERVICE_TIMEOUT_MS=120000
# ROBINHOOD_JUPYTER_PORT=8888
# ROBINHOOD_NOTEBOOK_PORT=8010
# RH_JUPYTER_TOKEN=choose-a-token
# TRACKER_FINANCE_ROBINHOOD_CASH_BALANCE=179.11

# --- Robinhood Agentic Trading MCP (Phase 1 read-only sync, Phase 2 execution) ---
# TRACKER_FINANCE_ROBINHOOD_AGENTIC_ENABLED=true
# TRACKER_FINANCE_ROBINHOOD_AGENTIC_SERVICE_BASE_URL=http://robinhood-agent:8020
# TRACKER_FINANCE_ROBINHOOD_AGENTIC_TOKEN_ENCRYPTION_KEY=change-me-long-random-passphrase
# When true, sync also pulls the primary (default) Robinhood account; false = Agentic account only.
# Use exactly true or false — no quotes, spaces, or trailing characters (e.g. true! breaks startup).
# TRACKER_FINANCE_ROBINHOOD_AGENTIC_SYNC_DEFAULT=false
# Optional scheduled sync (Spring cron, UTC). Example: every 30 minutes during market hours is up to you.
# TRACKER_FINANCE_ROBINHOOD_AGENTIC_SYNC_CRON=0 */30 * * * *
# Phase 2: allow place_equity_order via MCP (default false — opt in explicitly).
# TRACKER_FINANCE_ROBINHOOD_AGENTIC_EXECUTION_ENABLED=true
# Optional server-wide max order notional (USD); users may set a lower per-user cap in the UI.
# TRACKER_FINANCE_ROBINHOOD_AGENTIC_DEFAULT_MAX_ORDER_NOTIONAL=500
# Phase 3: AI auto-trade scheduler (Predicts → Agentic). Requires EXECUTION_ENABLED=true.
# TRACKER_FINANCE_ROBINHOOD_AGENTIC_AUTO_TRADE_ENABLED=true
# Optional poll interval in ms (default 300000 = 5 minutes):
# TRACKER_FINANCE_ROBINHOOD_AGENTIC_AUTO_TRADE_POLL_MS=300000
# Finance → Credit: Robinhood Agentic Credit Card (Banking MCP). Reuses robinhood-agent sidecar + encryption key.
# TRACKER_FINANCE_ROBINHOOD_AGENTIC_BANKING_ENABLED=true

# --- Robinhood Daily Tracker (Reports → Robinhood → Daily Tracker) ---
# Automatic hourly snapshots from 12 AM + daily close row (default 9 PM Central). Set false to disable.
# TRACKER_FINANCE_RH_DAILY_TRACKER_SNAPSHOT_ENABLED=true
# Spring 6-field cron (second minute hour day month weekday), America/Chicago zone. Default: every hour at :00.
# TRACKER_FINANCE_RH_DAILY_TRACKER_SNAPSHOT_CRON=0 0 * * * *
# TRACKER_FINANCE_RH_DAILY_TRACKER_SNAPSHOT_ZONE=America/Chicago
# Hour (0–23) when the official daily SCHEDULED row is written (shown as 9 PM CST in the day list).
# TRACKER_FINANCE_RH_DAILY_TRACKER_SNAPSHOT_CLOSING_HOUR=21
# Per-account spike email alerts after each Daily Tracker capture (requires Finance notification email).
# TRACKER_FINANCE_RH_DAILY_TRACKER_ALERTS_ENABLED=true
# On-demand OpenAI coaching on Daily Tracker habits (Reports → Robinhood → Daily Tracker → AI Insights).
# TRACKER_FINANCE_RH_DAILY_TRACKER_AI_ENABLED=false
# TRACKER_FINANCE_RH_DAILY_TRACKER_AI_API_KEY=
# TRACKER_FINANCE_RH_DAILY_TRACKER_AI_MODEL=gpt-4o-mini

# --- Robinhood Crypto Tracker (Reports → Robinhood → Crypto Tracker) ---
# Automatic crypto holdings snapshots via Crypto Trading API (separate from Daily Tracker).
# TRACKER_FINANCE_RH_CRYPTO_TRACKER_SNAPSHOT_ENABLED=true
# Spring 6-field cron (second minute hour day month weekday). Default: every 4 hours at :00.
# TRACKER_FINANCE_RH_CRYPTO_TRACKER_SNAPSHOT_CRON=0 0 */4 * * *

# --- Robinhood Crypto auto-trade (Predicts → market orders via Crypto Trading API) ---
# Server master switch — off by default in production until explicitly enabled.
# TRACKER_FINANCE_RH_CRYPTO_AUTO_TRADE_ENABLED=false
# Spring 6-field cron. Default: every 5 minutes.
# TRACKER_FINANCE_RH_CRYPTO_AUTO_TRADE_POLL_CRON=0 */5 * * * *
