# Copy to application-local.yml (same directory) and replace placeholders.
# application-local.yml is gitignored — never commit it.
#
# Run the server with the local profile so this file is loaded:
#   SPRING_PROFILES_ACTIVE=local mvn -f server spring-boot:run

spring:
  datasource:
    # Default docker-compose in repo root uses port 5433, db tracker, user tracker.
    url: jdbc:postgresql://localhost:5433/tracker
    username: tracker
    password: tracker

tracker:
  # Optional comma-separated inboxes for Contact us feedback when ADMIN accounts have no profile email.
  feedback:
    fallback-admin-emails: ""

  # Admin → Repository (GitHub): REST insights (contributors, commits, stars, optional traffic/views).
  github:
    enabled: false
    owner: ""
    repo: ""
    api-token: ""

  # Sign-in links in transactional emails (first profile saved, password changed). Production: your real web origin.
  web:
    public-app-url: "http://localhost:4200"

  auth:
    # Use long random values on your machine; do not reuse production secrets.
    jwt-secret: "CHANGE_ME_LOCAL_JWT_SECRET_AT_LEAST_32_CHARS"
    password-pepper: "CHANGE_ME_LOCAL_PEPPER"
    bootstrap-admin-password: "CHANGE_ME_LOCAL_ADMIN_PASSWORD"
    # Optional: Amazon SNS for MFA SMS (only if tracker.auth.sms.enabled=true, provider=sns, aws-region set)
    sms:
      provider: log
      aws-region: ""
      sms-sms-type: TRANSACTIONAL
      sms-sender-id: ""

  finance:
    # Absolute paths for POST /import-csv-directory (leave empty if unused).
    robinhood-csv-import-directory: "/absolute/path/to/robinhood/import"
    robinhood-csv-uploaded-directory: "/absolute/path/to/robinhood/uploaded"
    banking:
      # Banking uploads (CSV, QFX, QIF, QBO, Excel, PDF). Default when unset: ~/imports/banking.
      import-directory: "/absolute/path/to/imports/banking"
      # Optional Plaid (Link + /transactions → QFX under import-directory/output-subdirectory).
      plaid:
        enabled: false
        client-id: ""
        secret: ""
        environment: sandbox
        output-subdirectory: plaid
        # Optional: seals Plaid access_token in DB (same as TRACKER_PLAID_ACCESS_TOKEN_ENCRYPTION_KEY).
        # access-token-encryption-key: ""
    alerts:
      # When true + email-from + aws-region, SES also sends transactional account emails (first profile, password change).
      # Set true only after SES/SNS + aws-region + AWS credentials are configured for local tests.
      email-enabled: false
      email-from: ""
      sms-enabled: false
      aws-region: ""
      sms-sms-type: TRANSACTIONAL
      sms-sender-id: ""

  # Management → Travel: set TRACKER_TRAVEL_GEOCODE_USER_AGENT (a full https URL is fine in env vars; avoid https in YAML ${…:default}).
  # management:
  #   travel:
  #     geocode-user-agent: "MyApp/1.0 (https://example.com/contact)"
