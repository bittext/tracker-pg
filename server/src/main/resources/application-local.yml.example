# Copy to application-local.yml and fill in your values.
# application-local.yml is gitignored.
#
# Run server with local profile:
#   SPRING_PROFILES_ACTIVE=local mvn spring-boot:run

spring:
  datasource:
    url: jdbc:postgresql://localhost:5433/tracker
    username: tracker
    password: tracker

tracker:
  finance:
    robinhood-csv-import-directory: "/absolute/path/to/robinhood/import"
    robinhood-csv-uploaded-directory: "/absolute/path/to/robinhood/uploaded"
