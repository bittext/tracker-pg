# Copy to .env.migration in this directory (gitignored). Values usually match sibling Oracle `tracker`
# `server/src/main/resources/application-local.yml` and Postgres `.env.stack` / docker compose.

export ORACLE_JDBC_URL='jdbc:oracle:thin:@//localhost:1521/FREEPDB1'
export ORACLE_USER='your_oracle_user'
export ORACLE_PASSWORD='your_oracle_password'
export ORACLE_SCHEMA='SPULIC'
export ORACLE_ROBINHOOD_TABLE='ROBINHOOD_TRANSACTIONS'

export PG_JDBC_URL='jdbc:postgresql://localhost:5433/tracker'
export PG_USER='tracker'
export PG_PASSWORD='your_postgres_password'

# Set to false to append without truncating (may fail on duplicate keys).
export MIGRATE_TRUNCATE_FIRST='true'
