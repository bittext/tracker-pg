meta {
  name: Ownership History
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/finance/robinhood/ownership-history?year={{year}}&assetKind=equity&symbol={{symbol}}&accountSuffix={{accountSuffix}}&captureKind=SCHEDULED
  body: none
  auth: inherit
}

docs {
Equity share-count history (default) or option contracts (assetKind=option) from Daily Tracker holdings_json.
Options start 2026-06-28. Omit contractKey for all contracts; pass contractKey for one series.
Updated by the existing hourly / 9 PM snapshot job — no separate cron.
}
