meta {
  name: Ensure Authenticated
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/auth/me
  body: none
  auth: inherit
}

script:pre-request {
  const token = (bru.getEnvVar("token") || "").trim();
  if (token) {
    console.log("Using existing token");
    return;
  }

  const baseUrl = String(bru.getEnvVar("baseUrl") || "").replace(/\/$/, "");
  const username = String(
    bru.getEnvVar("username") ||
      (typeof bru.getProcessEnv === "function" ? bru.getProcessEnv("BRUNO_USERNAME") : "") ||
      ""
  ).trim();
  const password = String(
    bru.getEnvVar("password") ||
      (typeof bru.getProcessEnv === "function" ? bru.getProcessEnv("BRUNO_PASSWORD") : "") ||
      ""
  );
  const autoLogin = String(bru.getEnvVar("autoLogin") || "").toLowerCase() === "true";

  if (!username || !password) {
    throw new Error(
      "Missing credentials. Set BRUNO_USERNAME/BRUNO_PASSWORD in bruno/tracker-pg/.env, or username/password on the active env."
    );
  }
  if (!autoLogin && !(username && password)) {
    throw new Error("No token. Run Login (sets token), or enable autoLogin with credentials.");
  }
  if (!baseUrl) {
    throw new Error("No baseUrl — select Local or Production environment.");
  }

  const loginRes = await bru.sendRequest({
    method: "POST",
    url: baseUrl + "/api/auth/login",
    headers: { "Content-Type": "application/json", Accept: "application/json" },
    data: {
      username,
      password,
      locationFingerprintSource: bru.getEnvVar("locationFingerprintSource") || "bruno-collection",
      locationLabel: bru.getEnvVar("locationLabel") || "Bruno Ensure Authenticated",
    },
  });
  const body = loginRes.data || {};
  if (body.mfaRequired) {
    bru.setEnvVar("challengeId", body.challengeId || "", { persist: true });
    throw new Error("MFA required — run MFA Verify with challengeId + OTP.");
  }
  if (!body.token || !body.token.token) {
    throw new Error("Auto-login failed: " + JSON.stringify(body));
  }
  bru.setEnvVar("token", body.token.token, { persist: true });
  bru.setEnvVar("username", body.token.username || username, { persist: true });
  bru.setEnvVar("role", body.token.role || "", { persist: true });
  console.log("Auto-login OK as", body.token.username);
}

docs {
Uses cached `token`, else logs in via env credentials or `bruno/tracker-pg/.env`
(`BRUNO_USERNAME` / `BRUNO_PASSWORD`).
}
