meta {
  name: Step-Up
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/step-up
  body: json
  auth: inherit
}

body:json {
{
  "password": "{{password}}"
}
}

script:post-response {

  const body = res.getBody() || {};
  if (body.stepUpToken) {
    bru.setEnvVar("stepUpToken", body.stepUpToken, { persist: true });
    console.log("stepUpToken saved, expiresAt=", body.expiresAt);
  }

}

docs {
Password re-prompt for sensitive markets ops. Use header X-Step-Up-Token: {{stepUpToken}}.
}
