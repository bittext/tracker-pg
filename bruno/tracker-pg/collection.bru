meta {
  name: tracker-pg
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

script:pre-request {
  const url = String(req.getUrl() || "");
  // Public endpoints — no JWT required.
  if (
    url.includes("/api/version") ||
    url.includes("/api/auth/login") ||
    url.includes("/api/auth/mfa/") ||
    url.includes("/api/auth/register") ||
    url.includes("/privacy") ||
    url.includes("/terms")
  ) {
    return;
  }

  // Request opted out of collection bearer auth.
  try {
    if (typeof req.getAuthMode === "function" && req.getAuthMode() === "none") {
      return;
    }
  } catch (_) {}

  const token = String(bru.getEnvVar("token") || "").trim();
  if (token) {
    return;
  }

  const baseUrl = String(bru.getEnvVar("baseUrl") || "").replace(/\/$/, "");
  if (!baseUrl) {
    throw new Error(
      "No active environment. Top-right dropdown → select Local (or Production), then set username/password."
    );
  }

  const username = String(
    bru.getEnvVar("username") ||
      (typeof bru.getProcessEnv === "function" ? bru.getProcessEnv("BRUNO_USERNAME") : "") ||
      ""
  ).trim();
  const password = String(
    bru.getEnvVar("password") ||
      (typeof bru.getProcessEnv === "function" ? bru.getProcessEnv("BRUNO_PASSWORD") : "") ||
      ""
  );
  const autoLogin = String(bru.getEnvVar("autoLogin") || "").toLowerCase() === "true";
  // Auto-login when credentials exist (or autoLogin=true).
  const shouldAutoLogin = Boolean(username && password) || autoLogin;

  if (!shouldAutoLogin) {
    throw new Error(
      "No token. Select Local/Production, set credentials in .env (BRUNO_USERNAME/BRUNO_PASSWORD) or the env Secrets tab, then retry — or run 01 Auth → Login."
    );
  }

  if (!username || !password) {
    throw new Error(
      "Missing credentials. Set BRUNO_USERNAME and BRUNO_PASSWORD in bruno/tracker-pg/.env (gitignored), or fill username/password on the active environment Secrets tab."
    );
  }

  let loginRes;
  try {
    loginRes = await bru.sendRequest({
      method: "POST",
      url: baseUrl + "/api/auth/login",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      data: {
        username,
        password,
        locationFingerprintSource: bru.getEnvVar("locationFingerprintSource") || "bruno-collection",
        locationLabel: bru.getEnvVar("locationLabel") || "Bruno collection auto-login",
      },
    });
  } catch (err) {
    const status = err?.response?.status || err?.status || "";
    const detail =
      err?.response?.data?.message ||
      err?.response?.data?.error ||
      err?.message ||
      String(err);
    throw new Error(
      "Login failed" +
        (status ? " (" + status + ")" : "") +
        ": " +
        detail +
        ". Update BRUNO_USERNAME / BRUNO_PASSWORD in bruno/tracker-pg/.env for " +
        baseUrl +
        " (admin/admin123 is only the local bootstrap default)."
    );
  }

  const body = loginRes.data || {};
  if (body.mfaRequired) {
    bru.setEnvVar("challengeId", body.challengeId || "", { persist: true });
    throw new Error(
      "MFA required — set otpCode and run 01 Auth → MFA Verify, then retry."
    );
  }
  if (!body.token || !body.token.token) {
    throw new Error("Auto-login failed: " + JSON.stringify(body));
  }

  bru.setEnvVar("token", body.token.token, { persist: true });
  bru.setEnvVar("username", body.token.username || username, { persist: true });
  bru.setEnvVar("role", body.token.role || "", { persist: true });
  bru.setEnvVar("expiresAt", body.token.expiresAt || "", { persist: true });
  console.log("Collection auto-login OK as", body.token.username);
}

script:post-response {
  if (res.getStatus() === 401) {
    const body = res.getBody();
    console.log(
      "401 unauthorized — clear env token and re-run Login, or enable autoLogin with username/password.",
      typeof body === "object" ? JSON.stringify(body) : body
    );
  }
}

docs {
  # tracker-pg API

  Bearer JWT collection. Authenticate once, then call any grouped request.

  ## Auth options

  1. **Standalone login** — run `01 Auth / Login (sets token)`.
     Saves `token`, `username`, `role`, `expiresAt` into the active environment.
  2. **Collection auto-login** — set env `autoLogin` to `true` and fill `username` /
     `password`. Any request without a token will login first (Local defaults to this).
  3. **Pre-authenticated** — paste a JWT into env var `token`.
  4. **Ensure Authenticated** — `01 Auth / Ensure Authenticated` as an explicit gate.
  5. **MFA** — if login returns `mfaRequired`, run `01 Auth / MFA Verify` with
     `challengeId` + OTP.
  6. **Step-up** — for 403 `step_up_required`, run `01 Auth / Step-Up` then use header
     `X-Step-Up-Token: {{stepUpToken}}` on the sensitive call.

  ## Environments

- **Local** → `http://127.0.0.1:9091` (`autoLogin` defaults to `true`)
- **Production** → `https://phoenix-nexus.com` (`autoLogin` defaults to `true`)

Set `username` / `password` (Secrets tab) in the active environment. Protected
requests reuse `token` when present; otherwise they login, cache the JWT, and continue.
}
